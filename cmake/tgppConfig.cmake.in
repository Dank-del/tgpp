@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(nlohmann_json 3.11)
if(@TGPP_WITH_CURL@)
    find_dependency(CURL 7.68)
endif()
if(@TGPP_WITH_SQLITE@)
    find_dependency(SQLite3)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tgppTargets.cmake")
foreach(component IN LISTS tgpp_FIND_COMPONENTS)
    if(TARGET tgpp::${component})
        set(tgpp_${component}_FOUND TRUE)
    else()
        set(tgpp_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(tgpp)
